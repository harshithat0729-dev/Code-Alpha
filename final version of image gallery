<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IMAGE GALLERY</title>

  <style>
    :root {
      --bg-color: #f7f3ff;
      --text-color: #30264a;
      --card-bg: #ffffff;
      --card-border: #eee5fa;
      --hero-bg: linear-gradient(135deg, #e8ddff, #f9e8f5, #e0eaff);
      --nav-bg: #ffffffaa;
      --nav-border: #ebdffc;
      --btn-bg: #ffffff;
      --btn-color: #594477;
      --btn-border: #d9c9f5;
      --status-color: #76658b;
      --placeholder-color: #79668f;
      --modal-bg: #ffffff;
    }

    [data-theme="dark"] {
      --bg-color: #120f1d;
      --text-color: #e4dff7;
      --card-bg: #1a162b;
      --card-border: #2c2444;
      --hero-bg: linear-gradient(135deg, #22193b, #301f38, #18223b);
      --nav-bg: #1a162baa;
      --nav-border: #2c2444;
      --btn-bg: #221c38;
      --btn-color: #d1bfff;
      --btn-border: #3d315e;
      --status-color: #b0a3c7;
      --placeholder-color: #b0a3c7;
      --modal-bg: #1a162b;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg-color);
      color: var(--text-color);
      min-height: 100vh;
    }

    .hero {
      text-align: center;
      padding: 40px 20px 25px;
      background: var(--hero-bg);
      background-size: 200% 200%;
      animation: gradientFlow 10s ease infinite;
      position: relative;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 50px);
      font-weight: 800;
      letter-spacing: -1px;
      animation: fadeSlideUp 0.9s ease both;
      text-transform: uppercase;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #7952b3, #bb65a7, #7952b3);
      background-size: 200% auto;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: textShine 4s linear infinite;
    }

    /* Top navigation layout bar */
    .top-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 15px;
      padding: 15px 30px;
      background: var(--nav-bg);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--nav-border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .search-section {
      flex: 0 1 250px;
    }

    #searchInput {
      width: 100%;
      padding: 9px 16px;
      border: 1px solid var(--btn-border);
      border-radius: 25px;
      font-size: 14px;
      outline: none;
      background: var(--card-bg);
      color: var(--text-color);
      transition: 0.3s ease;
    }

    #searchInput:focus {
      border-color: #956bc9;
      box-shadow: 0 0 0 4px #7952b325;
    }

    .toolbar {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      flex: 1 1 auto;
    }

    .filter-btn {
      padding: 8px 14px;
      border: 1px solid var(--btn-border);
      border-radius: 20px;
      background: var(--btn-bg);
      color: var(--btn-color);
      cursor: pointer;
      font-size: 13px;
      transition: 0.25s ease;
    }

    .filter-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 10px #7952b333;
    }

    .filter-btn.active {
      background: #7952b3;
      color: white;
      border-color: #7952b3;
    }

    .action-buttons {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .control-btn {
      padding: 9px 16px;
      background: linear-gradient(135deg, #7952b3, #a265bb);
      color: white;
      border: none;
      border-radius: 25px;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
      transition: 0.25s ease;
      box-shadow: 0 4px 12px #7952b344;
    }

    .control-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px #7952b366;
    }

    .theme-toggle {
      background: var(--btn-bg);
      color: var(--btn-color);
      border: 1px solid var(--btn-border);
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: 0.2s;
    }

    .theme-toggle:hover {
      transform: scale(1.08);
    }

    #status {
      text-align: center;
      padding: 15px 15px 5px;
      color: var(--status-color);
      font-size: 14px;
    }

    .gallery {
      max-width: 1250px;
      margin: auto;
      padding: 10px 24px 50px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .card {
      min-width: 0;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 5px 20px #39215b10;
      animation: fadeSlideUp 0.55s ease both;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 32px #65428b25;
    }

    .fav-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(255, 255, 255, 0.8);
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      z-index: 10;
      transition: transform 0.2s;
    }

    .fav-btn:hover {
      transform: scale(1.15);
    }

    .fav-btn.active {
      background: #ff4757;
      color: white;
    }

    .image-wrap {
      height: 195px;
      position: relative;
      overflow: hidden;
      background: #e9e0f4;
      cursor: pointer;
    }

    .card img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      opacity: 0;
      transition: transform 0.55s ease, opacity 0.3s ease;
    }

    .card img.loaded {
      opacity: 1;
    }

    .card:hover img.loaded {
      transform: scale(1.08);
    }

    .placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px;
      text-align: center;
      color: var(--placeholder-color);
      font-size: 13px;
      line-height: 1.5;
    }

    .placeholder .symbol {
      font-size: 30px;
    }

    .placeholder.hidden {
      display: none;
    }

    .card-info {
      padding: 16px;
    }

    .card-info h3 {
      font-size: 16px;
      line-height: 1.4;
      margin-bottom: 10px;
      cursor: pointer;
    }

    .card-info h3:hover {
      color: #7952b3;
    }

    .category {
      display: inline-block;
      font-size: 12px;
      background: #f0e8ff;
      color: #704ba4;
      padding: 6px 11px;
      border-radius: 20px;
    }

    [data-theme="dark"] .category {
      background: #2a2142;
      color: #c9b1ff;
    }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 55px 15px;
      color: var(--status-color);
    }

    /* Modal Overlay */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(30, 20, 50, 0.75);
      backdrop-filter: blur(5px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-content {
      background: var(--modal-bg);
      max-width: 600px;
      width: 100%;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
      transform: translateY(20px);
      transition: transform 0.3s ease;
      position: relative;
    }

    .modal-overlay.open .modal-content {
      transform: translateY(0);
    }

    .modal-img-wrap {
      height: 300px;
      background: #e9e0f4;
      position: relative;
    }

    .modal-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-body {
      padding: 22px;
    }

    .modal-body h2 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .modal-category {
      display: inline-block;
      font-size: 12px;
      background: #f0e8ff;
      color: #704ba4;
      padding: 4px 10px;
      border-radius: 12px;
      margin-bottom: 10px;
    }

    [data-theme="dark"] .modal-category {
      background: #2a2142;
      color: #c9b1ff;
    }

    .modal-desc {
      font-size: 14px;
      color: var(--status-color);
      line-height: 1.6;
      margin-bottom: 15px;
    }

    .modal-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      border-top: 1px solid var(--card-border);
      padding-top: 15px;
    }

    .modal-link {
      color: #7952b3;
      font-size: 13px;
      text-decoration: none;
      font-weight: bold;
    }

    .modal-link:hover {
      text-decoration: underline;
    }

    .download-btn {
      padding: 8px 16px;
      background: #7952b3;
      color: white;
      border: none;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
      font-weight: bold;
      transition: background 0.2s;
    }

    .download-btn:hover {
      background: #65428b;
    }

    .modal-close-btn {
      position: absolute;
      top: 15px;
      right: 15px;
      background: rgba(0,0,0,0.5);
      color: white;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      z-index: 10;
    }

    .modal-close-btn:hover {
      background: rgba(0,0,0,0.8);
    }

    @keyframes gradientFlow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    @keyframes textShine {
      to { background-position: 200% center; }
    }

    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 1000px) {
      .gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .top-nav-bar {
        justify-content: center;
      }
    }

    @media (max-width: 700px) {
      .gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 10px 14px 35px;
        gap: 14px;
      }
      .image-wrap {
        height: 165px;
      }
    }

    @media (max-width: 420px) {
      .gallery {
        grid-template-columns: 1fr;
      }
      .image-wrap {
        height: 220px;
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <h1>IMAGE <span>GALLERY</span></h1>
  </header>

  <!-- Top bar with Search, Categories, Shuffle, Favorites, and Dark Theme Toggle -->
  <div class="top-nav-bar">
    <div class="search-section">
      <input
        id="searchInput"
        type="search"
        placeholder="Search photos..."
        aria-label="Search photos"
      >
    </div>

    <nav class="toolbar" id="filters" aria-label="Gallery categories"></nav>

    <div class="action-buttons">
      <button class="control-btn" id="shuffleBtn">🔀 Shuffle</button>
      <button class="control-btn" id="favFilterBtn">❤️ Favs</button>
      <button class="theme-toggle" id="themeToggle" title="Toggle Dark/Light Mode">🌙</button>
    </div>
  </div>

  <p id="status" aria-live="polite">Preparing your gallery...</p>

  <main class="gallery" id="gallery"></main>

  <!-- Modal for Details, Download and Resource Link -->
  <div class="modal-overlay" id="imageModal">
    <div class="modal-content">
      <button class="modal-close-btn" id="modalClose">&times;</button>
      <div class="modal-img-wrap">
        <img id="modalImg" src="" alt="">
      </div>
      <div class="modal-body">
        <span class="modal-category" id="modalCategory"></span>
        <h2 id="modalTitle"></h2>
        <p class="modal-desc" id="modalDesc"></p>
        <div class="modal-actions">
          <a id="modalSourceLink" class="modal-link" href="#" target="_blank" rel="noopener noreferrer">View image source ↗</a>
          <a id="modalDownloadBtn" class="download-btn" download="gallery-image.jpg">📥 Download Image</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const collections = [
      {
        category: "Landmarks",
        items: [
          ["Taj Mahal", "Taj Mahal Agra India", "Located in Agra, Uttar Pradesh, it is a stunning white marble mausoleum built by Mughal Emperor Shah Jahan."],
          ["Red Fort", "Red Fort Delhi India", "Historic fortification in Old Delhi that served as the main residence of the Mughal Emperors."],
          ["India Gate", "India Gate New Delhi India", "A war memorial located astride the Rajpath on the eastern edge of the ceremonial axis of New Delhi."],
          ["Qutub Minar", "Qutub Minar Delhi India", "A 73-meter high victory tower built in Delhi in 1193 by Qutb-ud-din Aibak."]
        ]
      },
      {
        category: "Nature",
        items: [
          ["Kerala Backwaters", "Kerala backwaters India", "A network of brackish lagoons and lakes lying parallel to the Arabian Sea coast in Kerala."],
          ["Himalayas", "Himalayas mountain range", "The majestic mountain range in Asia separating the plains of the Indian subcontinent from the Tibetan Plateau."],
          ["Valley of Flowers", "Alpine flowers Valley of Flowers Uttarakhand", "A vibrant national park in Uttarakhand featuring blooming alpine flowers, meadows, and rare endemic flora."],
          ["Western Ghats", "Western Ghats landscape India", "A mountain range running parallel to the western coast of the Indian peninsula, known for rich biodiversity."]
        ]
      },
      {
        category: "Festivals",
        items: [
          ["Diwali Celebration", "Diwali festival India lights", "The Hindu festival of lights signifying the victory of light over darkness and good over evil."],
          ["Holi Festival", "Holi festival India colours", "A popular ancient Hindu festival, also known as the Festival of Love and Colours."],
          ["Durga Puja", "Durga Puja Kolkata India", "An annual Hindu festival originating in West Bengal celebrating goddess Durga and her victory over Mahishasura."],
          ["Ganesh Chaturthi", "Ganesh Chaturthi India festival", "A vibrant Hindu festival celebrating the arrival of Lord Ganesha to earth from Kailash with his mother."]
        ]
      },
      {
        category: "Food",
        items: [
          ["Hyderabadi Biryani", "Hyderabadi biryani India", "A world-famous aromatic rice dish originating from Hyderabad, blending fragrant basmati rice with spiced meat."],
          ["Masala Dosa", "Masala dosa South India", "A crispy fermented crepe made from rice batter and black lentils, stuffed with spiced mashed potatoes."],
          ["Indian Thali", "Indian thali traditional food", "A platter consisting of various dishes representing a balanced and wholesome traditional Indian meal."],
          ["Panipuri", "Pani puri snack India", "A beloved Indian street snack consisting of a round hollow crisp puri filled with flavored water and tamarind chutney[cite: 1]."]
        ]
      },
      {
        category: "Architecture",
        items: [
          ["Hawa Mahal", "Hawa Mahal Jaipur India", "A palace in Jaipur built from red and pink sandstone, famous for its unique honeycomb facade of 953 windows."],
          ["Mysore Palace", "Mysore Palace Karnataka India", "A historical palace and the official residence of the Wadiyar dynasty in Mysore, Karnataka."],
          ["Golden Temple", "Golden Temple Amritsar India", "The holiest gurdwara of Sikhism located in the city of Amritsar, Punjab, featuring stunning gold plating."],
          ["Meenakshi Temple", "Meenakshi Temple Madurai India", "A historic Hindu temple located on the southern bank of the Vaigai River in Madurai, Tamil Nadu."]
        ]
      },
      {
        category: "Wildlife",
        items: [
          ["Bengal Tiger", "Bengal tiger India wildlife", "A majestic tiger population found primarily in India and Bangladesh, known for its fierce beauty."],
          ["Indian Elephant", "Asian elephant India wildlife", "A magnificent pachyderm native to mainland Asia, deeply revered in Indian culture and heritage."],
          ["Indian Peacock", "Indian peacock national bird", "The national bird of India, celebrated for its gorgeous, colorful fan-like iridescent tail feathers."],
          ["Asiatic Lion", "Asiatic lion Gir India", "A lion subspecies that survives today only in Gujarat's Gir National Park and Wildlife Sanctuary."]
        ]
      },
      {
        category: "Beaches",
        items: [
          ["Goa Beach", "Goa beach India", "Famous coastal destination along the Arabian Sea known for lively shores, golden sands, and vibrant culture."],
          ["Marina Beach", "Marina Beach Chennai India", "A natural urban beach along the Bay of Bengal in Chennai, one of the longest natural urban beaches in the world."],
          ["Varkala Beach", "Varkala beach Kerala India", "A scenic beach in Kerala famous for its unique and picturesque laterite cliffs bordering the Arabian Sea."],
          ["Andaman Islands", "Andaman Islands beach India", "An archipelago in the Bay of Bengal known for crystal-clear turquoise waters and pristine white beaches."]
        ]
      },
      {
        category: "Culture",
        items: [
          ["Bharatanatyam", "Bharatanatyam classical dance India", "A major Indian classical dance form that originated in the temples of Tamil Nadu."],
          ["Kathakali", "Kathakali dance Kerala India", "A major form of classical Indian dance-drama known for its attractive make-up, elaborate costumes, and face masks."],
          ["Indian Classical Music", "Indian classical music performance", "Traditional music of the Indian subcontinent encompassing rich melodic structures like ragas."],
          ["Traditional Indian Art", "Madhubani painting folk art India", "A traditional style of folk painting practiced in the Mithila region of Bihar and Nepal."]
        ]
      }
    ];

    let allItems = collections.flatMap(group =>
      group.items.map(([title, query, desc]) => ({
        title,
        query,
        category: group.category,
        desc,
        id: title.toLowerCase().replace(/\s+/g, '-')
      }))
    );

    const gallery = document.getElementById("gallery");
    const filters = document.getElementById("filters");
    const searchInput = document.getElementById("searchInput");
    const status = document.getElementById("status");
    const shuffleBtn = document.getElementById("shuffleBtn");
    const favFilterBtn = document.getElementById("favFilterBtn");
    const themeToggle = document.getElementById("themeToggle");

    const modal = document.getElementById("imageModal");
    const modalImg = document.getElementById("modalImg");
    const modalTitle = document.getElementById("modalTitle");
    const modalCategory = document.getElementById("modalCategory");
    const modalDesc = document.getElementById("modalDesc");
    const modalSourceLink = document.getElementById("modalSourceLink");
    const modalDownloadBtn = document.getElementById("modalDownloadBtn");
    const modalClose = document.getElementById("modalClose");

    let activeCategory = "All";
    let searchTerm = "";
    let showFavoritesOnly = false;
    let favorites = JSON.parse(localStorage.getItem("gallery_favs") || "[]");
    const imageCache = new Map();

    // Dark Mode Initialization
    const savedTheme = localStorage.getItem("gallery_theme") || "light";
    if (savedTheme === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
      themeToggle.textContent = "☀️";
    }

    themeToggle.addEventListener("click", () => {
      const currentTheme = document.documentElement.getAttribute("data-theme");
      if (currentTheme === "dark") {
        document.documentElement.setAttribute("data-theme", "light");
        localStorage.setItem("gallery_theme", "light");
        themeToggle.textContent = "🌙";
      } else {
        document.documentElement.setAttribute("data-theme", "dark");
        localStorage.setItem("gallery_theme", "dark");
        themeToggle.textContent = "☀️";
      }
    });

    function createFilters() {
      const categories = [
        "All",
        ...collections.map(group => group.category)
      ];

      filters.innerHTML = "";

      categories.forEach(category => {
        const button = document.createElement("button");
        button.className =
          "filter-btn" +
          ((category === activeCategory && !showFavoritesOnly) ? " active" : "");
        button.textContent = category;

        button.addEventListener("click", () => {
          showFavoritesOnly = false;
          favFilterBtn.classList.remove("active");
          activeCategory = category;
          createFilters();
          renderGallery();
        });

        filters.appendChild(button);
      });
    }

    favFilterBtn.addEventListener("click", () => {
      showFavoritesOnly = !showFavoritesOnly;
      if (showFavoritesOnly) {
        favFilterBtn.classList.add("active");
        activeCategory = "All";
      } else {
        favFilterBtn.classList.remove("active");
      }
      createFilters();
      renderGallery();
    });

    function createCard(item, index) {
      const card = document.createElement("article");
      card.className = "card";
      card.style.animationDelay = `${(index % 8) * 50}ms`;

      const isFav = favorites.includes(item.id);

      const favBtn = document.createElement("button");
      favBtn.className = "fav-btn" + (isFav ? " active" : "");
      favBtn.innerHTML = isFav ? "❤️" : "🤍";
      favBtn.title = "Save to Favorites";

      favBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (favorites.includes(item.id)) {
          favorites = favorites.filter(id => id !== item.id);
          favBtn.classList.remove("active");
          favBtn.innerHTML = "🤍";
        } else {
          favorites.push(item.id);
          favBtn.classList.add("active");
          favBtn.innerHTML = "❤️";
        }
        localStorage.setItem("gallery_favs", JSON.stringify(favorites));
        if (showFavoritesOnly) renderGallery();
      });

      const imageWrap = document.createElement("div");
      imageWrap.className = "image-wrap";

      const placeholder = document.createElement("div");
      placeholder.className = "placeholder";
      placeholder.innerHTML = `
        <span class="symbol">📷</span>
        <span>Loading photo...</span>
      `;

      const img = document.createElement("img");
      img.alt = item.title;
      img.loading = index < 8 ? "eager" : "lazy";
      img.decoding = "async";
      img.crossOrigin = "anonymous";

      img.addEventListener("load", () => {
        img.classList.add("loaded");
        placeholder.classList.add("hidden");
      });

      img.addEventListener("error", () => {
        img.classList.remove("loaded");
        placeholder.classList.remove("hidden");
        placeholder.innerHTML = `
          <span class="symbol">🖼️</span>
          <span>Photo unavailable.</span>
        `;
      });

      imageWrap.append(img, placeholder);

      imageWrap.addEventListener("click", () => openModal(item, img.src));

      const info = document.createElement("div");
      info.className = "card-info";

      const title = document.createElement("h3");
      title.textContent = item.title;
      title.addEventListener("click", () => openModal(item, img.src));

      const category = document.createElement("span");
      category.className = "category";
      category.textContent = item.category;

      info.append(title, category);
      card.append(favBtn, imageWrap, info);

      loadImage(item, img, placeholder);

      return card;
    }

    function openModal(item, imgSrc) {
      modalImg.src = imgSrc;
      modalTitle.textContent = item.title;
      modalCategory.textContent = item.category;
      modalDesc.textContent = item.desc;
      
      modalSourceLink.href = "https://commons.wikimedia.org/wiki/Special:MediaSearch?type=image&search=" + encodeURIComponent(item.query);
      modalDownloadBtn.href = imgSrc;
      modalDownloadBtn.setAttribute("download", item.id + ".jpg");

      modal.classList.add("open");
    }

    async function loadImage(item, img, placeholder) {
      if (imageCache.has(item.query)) {
        img.src = imageCache.get(item.query);
        return;
      }

      try {
        const apiUrl = new URL("https://commons.wikimedia.org/w/api.php");

        apiUrl.search = new URLSearchParams({
          action: "query",
          generator: "search",
          gsrsearch: item.query,
          gsrnamespace: "6",
          gsrlimit: "8",
          prop: "imageinfo",
          iiprop: "url",
          iiurlwidth: "800",
          format: "json",
          origin: "*"
        });

        const response = await fetch(apiUrl);

        if (!response.ok) {
          throw new Error("Image API request failed");
        }

        const data = await response.json();
        const pages = Object.values(data.query?.pages || {});

        const photo = pages.find(page => {
          const info = page.imageinfo?.[0];
          return info && (info.thumburl || info.url);
        });

        if (!photo) {
          throw new Error("No matching photo found");
        }

        const info = photo.imageinfo[0];
        const imageUrl = info.thumburl || info.url;

        imageCache.set(item.query, imageUrl);
        img.src = imageUrl;

      } catch (error) {
        placeholder.classList.remove("hidden");
        placeholder.innerHTML = `
          <span class="symbol">🌐</span>
          <span>Unable to load photo.</span>
        `;

        console.error("Image loading error:", item.title, error);
      }
    }

    function renderGallery() {
      const visibleItems = allItems.filter(item => {
        const matchesCategory =
          showFavoritesOnly ? favorites.includes(item.id) :
          (activeCategory === "All" || item.category === activeCategory);

        const matchesSearch =
          item.title.toLowerCase().includes(searchTerm) ||
          item.category.toLowerCase().includes(searchTerm);

        return matchesCategory && matchesSearch;
      });

      gallery.innerHTML = "";

      if (visibleItems.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = showFavoritesOnly ? "No favorite photos saved yet." : "No photos found. Try another search.";
        gallery.appendChild(empty);
        status.textContent = "0 photos found";
        return;
      }

      visibleItems.forEach((item, index) => {
        gallery.appendChild(createCard(item, index));
      });

      status.textContent =
        `Showing ${visibleItems.length} of ${allItems.length} photos`;
    }

    searchInput.addEventListener("input", event => {
      searchTerm = event.target.value.trim().toLowerCase();
      renderGallery();
    });

    shuffleBtn.addEventListener("click", () => {
      for (let i = allItems.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [allItems[i], allItems[j]] = [allItems[j], allItems[i]];
      }
      renderGallery();
    });

    modalClose.addEventListener("click", () => {
      modal.classList.remove("open");
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.classList.remove("open");
      }
    });

    createFilters();
    renderGallery();
  </script>

</body>
</html>
