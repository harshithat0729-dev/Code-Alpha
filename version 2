
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Image Gallery</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f7f3ff;
      color: #30264a;
      min-height: 100vh;
    }

    .hero {
      text-align: center;
      padding: 55px 20px 42px;
      background: linear-gradient(135deg, #e8ddff, #f9e8f5, #e0eaff);
      background-size: 200% 200%;
      animation: gradientFlow 10s ease infinite;
    }

    .hero-badge {
      display: inline-block;
      padding: 9px 16px;
      border: 1px solid #ffffffb0;
      border-radius: 30px;
      background: #ffffff70;
      color: #7952b3;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    .hero h1 {
      margin: 18px 0 12px;
      font-size: clamp(36px, 6vw, 58px);
      font-weight: 800;
      letter-spacing: -1.5px;
      animation: fadeSlideUp 0.9s ease both;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #7952b3, #bb65a7, #7952b3);
      background-size: 200% auto;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: textShine 4s linear infinite;
    }

    .hero p {
      color: #655777;
      font-size: 16px;
      line-height: 1.6;
    }

    .hero-line {
      width: 65px;
      height: 4px;
      margin: 24px auto 0;
      border-radius: 10px;
      background: linear-gradient(90deg, #7952b3, #e8a6d6);
    }

    .toolbar {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 25px 16px 12px;
    }

    .filter-btn {
      padding: 10px 17px;
      border: 1px solid #d9c9f5;
      border-radius: 25px;
      background: white;
      color: #594477;
      cursor: pointer;
      font-size: 14px;
      transition: 0.25s ease;
    }

    .filter-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 14px #7952b333;
    }

    .filter-btn.active {
      background: #7952b3;
      color: white;
      border-color: #7952b3;
    }

    .search-area {
      text-align: center;
      padding: 18px 16px 20px;
    }

    #searchInput {
      width: min(440px, 100%);
      padding: 14px 19px;
      border: 1px solid #d8c9ef;
      border-radius: 25px;
      font-size: 15px;
      outline: none;
      background: white;
      transition: 0.3s ease;
    }

    #searchInput:focus {
      border-color: #956bc9;
      box-shadow: 0 0 0 4px #7952b325;
    }

    #status {
      text-align: center;
      padding: 0 15px 18px;
      color: #76658b;
      font-size: 14px;
    }

    .gallery {
      max-width: 1250px;
      margin: auto;
      padding: 10px 24px 50px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .card {
      min-width: 0;
      background: white;
      border: 1px solid #eee5fa;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 5px 20px #39215b10;
      animation: fadeSlideUp 0.55s ease both;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 32px #65428b25;
    }

    .image-wrap {
      height: 195px;
      position: relative;
      overflow: hidden;
      background: #e9e0f4;
    }

    .card img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      opacity: 0;
      transition: transform 0.55s ease, opacity 0.3s ease;
    }

    .card img.loaded {
      opacity: 1;
    }

    .card:hover img.loaded {
      transform: scale(1.08);
    }

    .placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px;
      text-align: center;
      color: #79668f;
      font-size: 13px;
      line-height: 1.5;
    }

    .placeholder .symbol {
      font-size: 30px;
    }

    .placeholder.hidden {
      display: none;
    }

    .card-info {
      padding: 16px;
    }

    .card-info h3 {
      font-size: 16px;
      line-height: 1.4;
      margin-bottom: 10px;
    }

    .category {
      display: inline-block;
      font-size: 12px;
      background: #f0e8ff;
      color: #704ba4;
      padding: 6px 11px;
      border-radius: 20px;
    }

    .view-link {
      display: inline-block;
      margin-top: 13px;
      color: #7952b3;
      font-size: 13px;
      text-decoration: none;
    }

    .view-link:hover {
      text-decoration: underline;
    }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 55px 15px;
      color: #76658b;
    }

    footer {
      text-align: center;
      padding: 25px 15px;
      background: #ece3fa;
      color: #655777;
      font-size: 14px;
    }

    @keyframes gradientFlow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    @keyframes textShine {
      to { background-position: 200% center; }
    }

    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 1000px) {
      .gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 10px 14px 35px;
        gap: 14px;
      }

      .image-wrap {
        height: 165px;
      }

      .card-info {
        padding: 12px;
      }

      .card-info h3 {
        font-size: 14px;
      }

      .filter-btn {
        padding: 9px 13px;
        font-size: 13px;
      }
    }

    @media (max-width: 420px) {
      .gallery {
        grid-template-columns: 1fr;
      }

      .image-wrap {
        height: 220px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <span class="hero-badge">EXPLORE • DISCOVER • ENJOY</span>
    <h1>Image <span>Gallery</span></h1>
    <p>Discover beautiful moments, one picture at a time.</p>
    <div class="hero-line"></div>
  </header>

  <nav class="toolbar" id="filters" aria-label="Gallery categories"></nav>

  <div class="search-area">
    <input
      id="searchInput"
      type="search"
      placeholder="Search photos..."
      aria-label="Search photos"
    >
  </div>

  <p id="status" aria-live="polite">Preparing your gallery...</p>

  <main class="gallery" id="gallery"></main>

  <footer>
    Thank you for exploring the gallery!
  </footer>

  <script>
    const collections = [
      {
        category: "Landmarks",
        items: [
          ["Taj Mahal", "Taj Mahal Agra India"],
          ["Red Fort", "Red Fort Delhi India"],
          ["India Gate", "India Gate New Delhi India"],
          ["Qutub Minar", "Qutub Minar Delhi India"]
        ]
      },
      {
        category: "Nature",
        items: [
          ["Kerala Backwaters", "Kerala backwaters India"],
          ["Himalayas", "Himalayas mountain India"],
          ["Valley of Flowers", "Valley of Flowers Uttarakhand India"],
          ["Western Ghats", "Western Ghats landscape India"]
        ]
      },
      {
        category: "Festivals",
        items: [
          ["Diwali Celebration", "Diwali festival India lights"],
          ["Holi Festival", "Holi festival India colours"],
          ["Durga Puja", "Durga Puja Kolkata India"],
          ["Ganesh Chaturthi", "Ganesh Chaturthi India festival"]
        ]
      },
      {
        category: "Food",
        items: [
          ["Hyderabadi Biryani", "Hyderabadi biryani India"],
          ["Masala Dosa", "Masala dosa South India"],
          ["Indian Thali", "Indian thali traditional food"],
          ["Gulab Jamun", "Gulab jamun Indian dessert"]
        ]
      },
      {
        category: "Architecture",
        items: [
          ["Hawa Mahal", "Hawa Mahal Jaipur India"],
          ["Mysore Palace", "Mysore Palace Karnataka India"],
          ["Golden Temple", "Golden Temple Amritsar India"],
          ["Meenakshi Temple", "Meenakshi Temple Madurai India"]
        ]
      },
      {
        category: "Wildlife",
        items: [
          ["Bengal Tiger", "Bengal tiger India wildlife"],
          ["Indian Elephant", "Asian elephant India wildlife"],
          ["Indian Peacock", "Indian peacock national bird"],
          ["Asiatic Lion", "Asiatic lion Gir India"]
        ]
      },
      {
        category: "Beaches",
        items: [
          ["Goa Beach", "Goa beach India"],
          ["Marina Beach", "Marina Beach Chennai India"],
          ["Varkala Beach", "Varkala beach Kerala India"],
          ["Andaman Islands", "Andaman Islands beach India"]
        ]
      },
      {
        category: "Culture",
        items: [
          ["Bharatanatyam", "Bharatanatyam classical dance India"],
          ["Kathakali", "Kathakali dance Kerala India"],
          ["Indian Classical Music", "Indian classical music performance"],
          ["Traditional Indian Art", "Indian traditional folk art"]
        ]
      }
    ];

    const allItems = collections.flatMap(group =>
      group.items.map(([title, query]) => ({
        title,
        query,
        category: group.category
      }))
    );

    const gallery = document.getElementById("gallery");
    const filters = document.getElementById("filters");
    const searchInput = document.getElementById("searchInput");
    const status = document.getElementById("status");

    let activeCategory = "All";
    let searchTerm = "";
    const imageCache = new Map();

    function createFilters() {
      const categories = [
        "All",
        ...collections.map(group => group.category)
      ];

      filters.innerHTML = "";

      categories.forEach(category => {
        const button = document.createElement("button");

        button.className =
          "filter-btn" +
          (category === activeCategory ? " active" : "");

        button.textContent = category;

        button.addEventListener("click", () => {
          activeCategory = category;
          createFilters();
          renderGallery();
        });

        filters.appendChild(button);
      });
    }

    function createCard(item, index) {
      const card = document.createElement("article");
      card.className = "card";
      card.style.animationDelay = `${(index % 8) * 50}ms`;

      const imageWrap = document.createElement("div");
      imageWrap.className = "image-wrap";

      const placeholder = document.createElement("div");
      placeholder.className = "placeholder";
      placeholder.innerHTML = `
        <span class="symbol">📷</span>
        <span>Loading photo...</span>
      `;

      const img = document.createElement("img");
      img.alt = item.title;
      img.loading = index < 8 ? "eager" : "lazy";
      img.decoding = "async";

      img.addEventListener("load", () => {
        img.classList.add("loaded");
        placeholder.classList.add("hidden");
      });

      img.addEventListener("error", () => {
        img.classList.remove("loaded");
        placeholder.classList.remove("hidden");
        placeholder.innerHTML = `
          <span class="symbol">🖼️</span>
          <span>Photo unavailable. Check your internet connection.</span>
        `;
      });

      imageWrap.append(img, placeholder);

      const info = document.createElement("div");
      info.className = "card-info";

      const title = document.createElement("h3");
      title.textContent = item.title;

      const category = document.createElement("span");
      category.className = "category";
      category.textContent = item.category;

      const link = document.createElement("a");
      link.className = "view-link";
      link.textContent = "View image source ↗";
      link.href =
        "https://commons.wikimedia.org/wiki/Special:MediaSearch?type=image&search=" +
        encodeURIComponent(item.query);
      link.target = "_blank";
      link.rel = "noopener noreferrer";

      info.append(title, category, document.createElement("br"), link);
      card.append(imageWrap, info);

      loadImage(item, img, placeholder);

      return card;
    }

    async function loadImage(item, img, placeholder) {
      if (imageCache.has(item.query)) {
        img.src = imageCache.get(item.query);
        return;
      }

      try {
        const apiUrl = new URL("https://commons.wikimedia.org/w/api.php");

        apiUrl.search = new URLSearchParams({
          action: "query",
          generator: "search",
          gsrsearch: item.query,
          gsrnamespace: "6",
          gsrlimit: "8",
          prop: "imageinfo",
          iiprop: "url",
          iiurlwidth: "800",
          format: "json",
          origin: "*"
        });

        const response = await fetch(apiUrl);

        if (!response.ok) {
          throw new Error("Image API request failed");
        }

        const data = await response.json();
        const pages = Object.values(data.query?.pages || {});

        const photo = pages.find(page => {
          const info = page.imageinfo?.[0];
          return info && (info.thumburl || info.url);
        });

        if (!photo) {
          throw new Error("No matching photo found");
        }

        const info = photo.imageinfo[0];
        const imageUrl = info.thumburl || info.url;

        imageCache.set(item.query, imageUrl);
        img.src = imageUrl;

      } catch (error) {
        placeholder.classList.remove("hidden");
        placeholder.innerHTML = `
          <span class="symbol">🌐</span>
          <span>Unable to load photo. Check your internet connection.</span>
        `;

        console.error("Image loading error:", item.title, error);
      }
    }

    function renderGallery() {
      const visibleItems = allItems.filter(item => {
        const matchesCategory =
          activeCategory === "All" ||
          item.category === activeCategory;

        const matchesSearch =
          item.title.toLowerCase().includes(searchTerm) ||
          item.category.toLowerCase().includes(searchTerm);

        return matchesCategory && matchesSearch;
      });

      gallery.innerHTML = "";

      if (visibleItems.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = "No photos found. Try another search.";
        gallery.appendChild(empty);
        status.textContent = "0 photos found";
        return;
      }

      visibleItems.forEach((item, index) => {
        gallery.appendChild(createCard(item, index));
      });

      status.textContent =
        `Showing ${visibleItems.length} of ${allItems.length} photos`;
    }

    searchInput.addEventListener("input", event => {
      searchTerm = event.target.value.trim().toLowerCase();
      renderGallery();
    });

    createFilters();
    renderGallery();

    console.log("Total categories:", collections.length);
    console.log("Total pictures:", allItems.length);
  </script>

</body>
</html>
